+def send_request(proc, request_id, method, params=None):
+  proc.stdin.write(json.dumps({"id": request_id, "method": method, "params": params or {}}) + "\n")
+  proc.stdin.flush()
+
+
+def await_answers(proc, request_ids, timeout=8):
+  answers = {}
+  deadline = time.time() + timeout
+  while time.time() < deadline and len(answers) < len(request_ids):
+    ready, _, _ = select.select([proc.stdout], [], [], 0.25)
+    if not ready:
+      continue
+    line = proc.stdout.readline()
+    if not line:
+      break
+    try:
+      message = json.loads(line)
+    except Exception:
+      continue
+    if message.get("id") in request_ids:
+      answers[message["id"]] = message
+  return answers
+
